[Unit]
Description=PredictionComp simulated player predictions
After=network-online.target
[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=/etc/predictioncomp/quiz-agent.env
ExecStart=/usr/bin/python3 /opt/predictioncomp/bin/simulated_players.py
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/predictioncomp
PrivateTmp=true
NoNewPrivileges=true
